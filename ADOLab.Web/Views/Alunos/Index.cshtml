@model List<Aluno>

@{
    ViewData["Title"] = "Gerenciar Alunos";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📚 Alunos</h2>
        <button class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#alunoModal" onclick="limparFormulario()">
            ➕ Novo Aluno
        </button>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Idade</th>
                        <th>Email</th>
                        <th>Data Nascimento</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody id="tabelaAlunos">
                    @foreach (var aluno in Model)
                    {
                        <tr id="row-@aluno.Id">
                            <td><strong>@aluno.Id</strong></td>
                            <td>@aluno.Nome</td>
                            <td>@aluno.Idade</td>
                            <td>@aluno.Email</td>
                            <td>@aluno.DataNascimento.ToString("dd/MM/yyyy")</td>
                            <td>
                                <button class="btn btn-sm btn-warning" onclick="editarAluno(@aluno.Id)">✏️ Editar</button>
                                <button class="btn btn-sm btn-danger" onclick="deletarAluno(@aluno.Id)">🗑️ Deletar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            📭 Nenhum aluno cadastrado. Clique em <strong>Novo Aluno</strong> para começar!
        </div>
    }
</div>

<!-- Modal -->
<div class="modal fade" id="alunoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitulo">Novo Aluno</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="formularioAluno" onsubmit="return false;">
                <div class="modal-body">
                    <input type="hidden" id="alunoId" />

                    <div class="mb-3">
                        <label for="nome" class="form-label">Nome <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="nome" required />
                    </div>

                    <div class="mb-3">
                        <label for="idade" class="form-label">Idade <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="idade" min="0" max="120" required />
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">Email <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" id="email" required />
                    </div>

                    <div class="mb-3">
                        <label for="dataNascimento" class="form-label">Data de Nascimento <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="dataNascimento" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">❌ Cancelar</button>
                    <button type="button" class="btn btn-primary" onclick="salvarAluno()">💾 Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let modal = new bootstrap.Modal(document.getElementById('alunoModal'));

        function limparFormulario() {
            document.getElementById('formularioAluno').reset();
            document.getElementById('alunoId').value = '';
            document.getElementById('modalTitulo').textContent = 'Novo Aluno';
        }

        function editarAluno(id) {
            fetch(`/Alunos/ObterPorId?id=${id}`)
                .then(r => {
                    if (!r.ok) throw new Error('Erro ao buscar aluno');
                    return r.json();
                })
                .then(aluno => {
                    document.getElementById('alunoId').value = aluno.id;
                    document.getElementById('nome').value = aluno.nome;
                    document.getElementById('idade').value = aluno.idade;
                    document.getElementById('email').value = aluno.email;
                    document.getElementById('dataNascimento').value = aluno.dataNascimento.split('T')[0];
                    document.getElementById('modalTitulo').textContent = 'Editar Aluno';
                    modal.show();
                })
                .catch(err => {
                    alert('Erro ao carregar aluno: ' + err.message);
                });
        }

        function salvarAluno() {
            const id = document.getElementById('alunoId').value;
            const aluno = {
                id: id ? parseInt(id) : 0,
                nome: document.getElementById('nome').value,
                idade: parseInt(document.getElementById('idade').value),
                email: document.getElementById('email').value,
                dataNascimento: document.getElementById('dataNascimento').value
            };

            if (!aluno.nome || !aluno.email) {
                alert('Nome e Email são obrigatórios!');
                return;
            }

            const url = id ? '/Alunos/Atualizar' : '/Alunos/Inserir';

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(aluno)
            })
            .then(r => {
                if (!r.ok) throw new Error('Erro ao salvar');
                return r.json();
            })
            .then(data => {
                if (data.success) {
                    modal.hide();
                    alert('✅ Salvo com sucesso!');
                    location.reload();
                } else {
                    alert('❌ Erro: ' + (data.message || 'Não foi possível salvar'));
                }
            })
            .catch(err => alert('Erro: ' + err.message));
        }

        function deletarAluno(id) {
            if (!confirm('Tem certeza que deseja deletar este aluno?')) return;

            fetch('/Alunos/Deletar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                 body: JSON.stringify({ id: id })
            })
            .then(r => {
                if (!r.ok) throw new Error('Erro ao deletar');
                return r.json();
            })
            .then(data => {
                if (data.success) {
                    const row = document.getElementById(`row-${id}`);
                    if (row) {
                        row.remove();
                        alert('✅ Deletado com sucesso!');
                    }
                    location.reload();
                } else {
                    alert('❌ Erro: ' + (data.message || 'Não foi possível deletar'));
                }
            })
            .catch(err => alert('Erro: ' + err.message));
        }
    </script>
}
